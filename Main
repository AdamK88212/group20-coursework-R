#####################################################
# Part iv — Share s3 object & Company summary print
#####################################################

make_share <- function(ticker, company_list, info) {
  df <- company_list[[ticker]]
  ci <- info[info$ticker == ticker, ]
  
  last_non_na <- function(x) {
    vals <- x[!is.na(x)]
    if (length(vals) == 0) return(NA)
    tail(vals, 1)
  }
  
  win <- tail(df$Price, 252)
  
  structure(
    list(
      ticker = ticker,
      company_name = ci$company_name,
      industry = ci$industry,
      current_price = tail(df$Price, 1),
      high_52wk = max(win, na.rm = TRUE),
      low_52wk = min(win, na.rm = TRUE),
      ma10 = last_non_na(df$MA10),
      ma50 = last_non_na(df$MA50),
      ma200 = last_non_na(df$MA200),
      last_updated = tail(df$Date, 1)
    ),
    class = "share"
  )
}

print.share <- function(x, ...) {
  cat("================================\n")
  cat("Ticker:", x$ticker, "\n")
  cat("Company:", x$company_name, "\n")
  cat("Industry:", x$industry, "\n")
  cat("Current Price:", round(x$current_price, 2), "\n")
  cat("52 Week High:", round(x$high_52wk, 2), "\n")
  cat("52 Week Low:", round(x$low_52wk, 2), "\n")
  cat("Current 10 day MA:", round(x$ma10, 2), "\n")
  cat("Current 50 day MA:", round(x$ma50, 2), "\n")
  cat("Current 200 day MA:", round(x$ma200, 2), "\n")
  cat("Updated:", as.character(x$last_updated), "\n")
  cat("================================\n")
}

build_shares_list <- function(company_list, info) {
  shares <- lapply(info$ticker, function(tkr) {
    make_share(tkr, company_list, info)
  })
  
  names(shares) <- info$ticker
  shares
}

#########################################
# part V — weekly feed update function
#########################################

update_feed <- function(weekly_file, company_file) {
  old_df <- readRDS("saved_data/main_df.rds")
  new_df <- build_historic_df(weekly_file)
  
  combined <- rbind(old_df[, names(new_df)], new_df)
  combined <- combined[!duplicated(combined$Date), ]
  combined <- combined[order(combined$Date), ]
  
  info <- load_company_info(company_file)
  res <- rebuild_indices(combined, info)
  
  save_data_frames(res$main_df, res$industry_dfs)
  
  company_list <- build_company_dfs(
    res$main_df,
    res$industry_dfs,
    info
  )
  
  save_company_dfs(company_list)
  
  invisible(res$main_df)
}

#################################
# part vi — portfolio s3 object
#################################

lookup_price <- function(ticker, date, company_list) {
  date <- as.Date(date)
  df <- company_list[[ticker]]
  idx <- which(df$Date == date)
  
  if (length(idx) == 0)
    stop("No price available for this date.")
  
  df$Price[idx[1]]
}

create_portfolio <- function(ticker, date, shares, company_list) {
  date <- as.Date(date)
  
  price_row <- company_list[[ticker]]
  price <- price_row$Price[price_row$Date == date]
  
  pf <- list(
    transactions = data.frame(
      ticker = ticker,
      type = "BUY",
      shares = shares,
      price = price,
      purchase_price = NA,
      realized_pl = NA,
      date = date,
      stringsAsFactors = FALSE
    ),
    company_list = company_list
  )
  
  class(pf) <- "portfolio"
  saveRDS(pf, "portfolio.rds")
  pf
}

buy_shares <- function(pf, ticker, date, shares) {
  date <- as.Date(date)
  
  price_row <- pf$company_list[[ticker]]
  price <- price_row$Price[price_row$Date == date]
  
  new_tx <- data.frame(
    ticker = ticker,
    type = "BUY",
    shares = shares,
    price = price,
    purchase_price = NA,
    realized_pl = NA,
    date = date,
    stringsAsFactors = FALSE
  )
  
  pf$transactions <- rbind(pf$transactions, new_tx)
  saveRDS(pf, "portfolio.rds")
  pf
}

sell_shares <- function(pf, ticker, date, shares) {
  date <- as.Date(date)
  
  holdings <- portfolio_summary(pf)
  
  if (!(ticker %in% names(holdings))) {
    stop("No shares currently held in this ticker")
  }
  
  holding <- holdings[[ticker]]
  
  if (shares > holding$shares) {
    stop("Cannot sell more shares than currently held")
  }
  
  price <- lookup_price(ticker, date, pf$company_list)
  realized_pl <- (price - holding$avg_price) * shares
  
  new_tx <- data.frame(
    ticker = ticker,
    type = "SELL",
    shares = shares,
    price = price,
    purchase_price = holding$avg_price,
    realized_pl = realized_pl,
    date = date,
    stringsAsFactors = FALSE
  )
  
  pf$transactions <- rbind(pf$transactions, new_tx)
  saveRDS(pf, "portfolio.rds")
  pf
}

portfolio_summary <- function(pf) {
  tx <- pf$transactions
  tickers <- unique(tx$ticker)
  
  holdings <- list()
  
  for (ticker in tickers) {
    sub <- tx[tx$ticker == ticker, ]
    sub <- sub[order(sub$date), ]
    
    shares_held <- 0
    avg_price <- 0
    
    for (i in seq_len(nrow(sub))) {
      row <- sub[i, ]
      
      if (row$type == "BUY") {
        total_cost <- shares_held * avg_price + row$shares * row$price
        shares_held <- shares_held + row$shares
        
        if (shares_held > 0) {
          avg_price <- total_cost / shares_held
        } else {
          avg_price <- 0
        }
      }
      
      if (row$type == "SELL") {
        shares_held <- shares_held - row$shares
        
        if (shares_held == 0) {
          avg_price <- 0
        }
      }
    }
    
    if (shares_held > 0) {
      current_price <- tail(pf$company_list[[ticker]]$Price, 1)
      
      holdings[[ticker]] <- list(
        shares = shares_held,
        avg_price = avg_price,
        current_value = shares_held * current_price,
        profit_loss = (current_price - avg_price) * shares_held
      )
    }
  }
  
  holdings
}

print.portfolio <- function(x, ...) {
  cat("\n========== PORTFOLIO ==========\n")
  
  sales <- x$transactions[x$transactions$type == "SELL", ]
  
  cat("\nCompleted Sales\n")
  if (nrow(sales) == 0) {
    cat("No completed sales\n")
  } else {
    for (i in seq_len(nrow(sales))) {
      row <- sales[i, ]
      
      cat(
        row$ticker,
        "| Purchase:", round(row$purchase_price, 2),
        "| Sold:", round(row$price, 2),
        "| Date:", as.character(row$date),
        "| Realized P/L:", round(row$realized_pl, 2),
        "\n"
      )
    }
  }
  
  cat("\nCurrent Holdings\n")
  holdings <- portfolio_summary(x)
  
  if (length(holdings) == 0) {
    cat("No current holdings\n")
  } else {
    for (ticker in names(holdings)) {
      item <- holdings[[ticker]]
      
      cat(
        ticker,
        "| Shares:", item$shares,
        "| Purchase:", round(item$avg_price, 2),
        "| Value:", round(item$current_value, 2),
        "| P/L:", round(item$profit_loss, 2),
        "\n"
      )
    }
  }
  
  cat("===============================\n")
}

refresh_portfolio <- function(filepath = "portfolio.rds") {
  pf <- readRDS(filepath)
  print(pf)
  invisible(pf)
}
